{
  "name": "pg-governance-agent",
  "version": "1.0.0",
  "description": "PgGuard Agent — corporate Postgres governance MCP server with RBAC, Vault secrets, and audit",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pgguard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "mcp": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false",
    "policy:check": "tsx src/policy/check.ts"
  },
  "keywords": [
    "postgres",
    "mcp",
    "governance",
    "rbac",
    "vault"
  ],
  "author": "PgGuard",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pg": "^8.16.0",
    "pgsql-ast-parser": "^12.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
