# PgGuard Agent — local demo (never commit real secrets)
PGGUARD_ROLE=reader
PGGUARD_SECRETS_PROVIDER=env
PGGUARD_MAX_ROWS=100
PGGUARD_AUDIT_DIR=./data/audit
PGGUARD_POLICY_PATH=./config/policy.yaml

# Env secrets fallback (used when PGGUARD_SECRETS_PROVIDER=env)
PGHOST=localhost
PGPORT=5432
PGDATABASE=corpdb
PGUSER=app_reader
PGPASSWORD=reader_demo_pass
PGSSLMODE=disable

# Vault (used when PGGUARD_SECRETS_PROVIDER=vault)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
# Or AppRole:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_KV_PATH=secret/data/pgguard/db
