# PgGuard Agent — local demo (never commit real secrets)
PGGUARD_ROLE=reader
PGGUARD_SECRETS_PROVIDER=env
PGGUARD_MAX_ROWS=100
PGGUARD_AUDIT_DIR=./data/audit
PGGUARD_POLICY_PATH=./config/policy.yaml

# Env secrets fallback (used when PGGUARD_SECRETS_PROVIDER=env)
PGHOST=localhost
PGPORT=5432
PGDATABASE=corpdb
PGUSER=app_reader
PGPASSWORD=reader_demo_pass
PGSSLMODE=disable
# Phase 5: non-loopback hosts need PGSSLMODE=verify-full and a CA bundle, and the host
# must be listed in policy.yaml network.allowed_db_hosts.
# PGSSLROOTCERT=./certs/db-ca.pem

# Vault (used when PGGUARD_SECRETS_PROVIDER=vault)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
# Or AppRole:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_KV_PATH=secret/data/pgguard/db

# Principal propagation (JWT → RLS session GUCs). Optional.
# Bearer JWTs are verified with HS256. When unset, tokens are refused (fail closed).
# PGGUARD_JWT_SECRET=
# Optional default bearer for all tools (prefer per-call bearer_token):
# PGGUARD_BEARER_TOKEN=

# Phase 1 security defaults (fail closed):
# - policy.yaml require_jwt: true → every DB tool call needs a bearer token verified with PGGUARD_JWT_SECRET.
# - No secret configured → tokens are refused, not decoded.
# Local dev ONLY: decode-only tokens and token-less calls. Never set this in shared or prod environments.
# PGGUARD_DEV_INSECURE_JWT=1
# Hex key (32 bytes) shared with pgguard.current_user_id() for RLS (docker/postgres/optional/rls-principal-verify.sql).
# PGGUARD_RLS_HMAC_KEY=

# Phase 4 approvals: the server gets ONLY the approver's public key (PEM text or file).
# PGGUARD_APPROVAL_PUBLIC_KEY_FILE=./approver.pub
# PGGUARD_APPROVALS_DIR=./data/approvals
# Never put PGGUARD_APPROVAL_PRIVATE_KEY_FILE in the server env (the server refuses to start).

# Phase 5 audit: HMAC key (hex, >= 32 bytes) for the audit hash chain. Without it the
# chain is plain sha256 (detects edits, but anyone with write access can rebuild it).
# PGGUARD_AUDIT_HMAC_KEY=
